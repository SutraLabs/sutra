include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
recursive-include docs *.md
recursive-include examples *.py *.json *.md
recursive-include scripts *.py
recursive-include src/sutra *.py *.json *.yml *.yaml *.md *.html
prune .venv
prune dist
prune .sutra
prune projects
prune __pycache__
prune .pytest_cache
global-exclude *.pdf *.docx *.DS_Store *.pyc
